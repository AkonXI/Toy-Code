{
  "name": "toy-code",
  "private": true,
  "version": "1.0.0",
  "description": "toy project collection",
  "scripts": {
    "dev:big-screen": "pnpm --filter big-screen dev",
    "dev:aiagent": "pnpm --filter aiagent dev",
    "dev:aiagentfe-vue": "pnpm --filter aiagentfe-vue dev",
    "dev:aiagentfe-react": "pnpm --filter aiagentfe-react dev",
    "dev:da-studio": "pnpm --filter da-studio dev",
    "dev:emoji-mouse": "pnpm --filter emoji-mouse dev",
    "dev:spell-check-editor": "pnpm --filter spell-check-editor dev",
    "build:big-screen": "pnpm --filter big-screen build",
    "build:aiagent": "pnpm --filter aiagent build",
    "build:aiagentfe-vue": "pnpm --filter aiagentfe-vue build",
    "build:aiagentfe-react": "pnpm --filter aiagentfe-react build",
    "build:da-studio": "pnpm --filter da-studio build",
    "build:emoji-mouse": "pnpm --filter emoji-mouse build",
    "build:spell-check-editor": "pnpm --filter spell-check-editor build"
  },
  "pnpm": {
    "overrides": {
      "vue-loader": "^15.11.1",
      "vite": "^8.0.16"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@rolldown/binding-win32-x64-msvc",
      "@swc/core",
      "better-sqlite3",
      "canvas",
      "core-js",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ]
  }
